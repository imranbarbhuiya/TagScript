{
	"name": "@tagscript/plugin-discord",
	"version": "3.1.0",
	"description": "A plugin for tagscript to work with discord.js.",
	"keywords": [
		"bot tag",
		"discord.js",
		"safe string",
		"string parser",
		"tag",
		"tagscript",
		"tagscript discord",
		"template",
		"template engine",
		"template string",
		"typescript"
	],
	"homepage": "https://tagscript.js.org/",
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/tagscript/issues"
	},
	"license": "MIT",
	"author": "@imranbarbhuiya",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/tagscript.git",
		"directory": "packages/tagscript-plugin-discord"
	},
	"files": [
		"dist/**/*.cjs*",
		"dist/**/*.mjs*",
		"dist/**/*.d*"
	],
	"sideEffects": false,
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"prepack": "bun run build",
		"test": "bun test",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:watch": "bun test --watch",
		"typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
	},
	"devDependencies": {
		"discord.js": "^14.27.0",
		"tagscript": "workspace:^"
	},
	"peerDependencies": {
		"discord.js": "^14.0.0",
		"tagscript": "*"
	},
	"engines": {
		"node": ">=v16.9.0"
	}
}
