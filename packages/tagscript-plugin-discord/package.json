{
	"name": "@tagscript/plugin-discord",
	"version": "4.0.0",
	"description": "Library agnostic Discord parsers and transformers for TagScript: embeds, cooldowns, permissions and mentions from user-written templates.",
	"keywords": [
		"bot tag",
		"discord",
		"discord-api-types",
		"discord-bot",
		"discord.js",
		"safe string",
		"sandbox",
		"string parser",
		"tag",
		"tagscript",
		"tagscript discord",
		"template",
		"template engine",
		"template string",
		"templating",
		"typescript",
		"user-generated-content"
	],
	"homepage": "https://tagscript.js.org/",
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/tagscript/issues"
	},
	"license": "MIT",
	"author": "@imranbarbhuiya",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/tagscript.git",
		"directory": "packages/tagscript-plugin-discord"
	},
	"files": [
		"dist/**/*.cjs*",
		"dist/**/*.mjs*",
		"dist/**/*.d*"
	],
	"sideEffects": false,
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bench": "bun bench/index.ts",
		"build": "tsdown",
		"prepack": "bun run build",
		"test": "bun test",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:watch": "bun test --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"discord-api-types": "^0.38.54"
	},
	"devDependencies": {
		"tagscript": "workspace:^"
	},
	"peerDependencies": {
		"tagscript": "*"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
