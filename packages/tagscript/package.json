{
	"name": "tagscript",
	"version": "2.0.0",
	"description": "A sandboxed template language for text your users write.",
	"keywords": [
		"interpreter",
		"safe string",
		"sandbox",
		"string parser",
		"tag",
		"tagscript",
		"template",
		"template engine",
		"template string",
		"template-language",
		"templating",
		"typescript",
		"user-generated-content"
	],
	"homepage": "https://tagscript.js.org/",
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/tagscript/issues"
	},
	"author": "@imranbarbhuiya",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/tagscript.git",
		"directory": "packages/tagscript"
	},
	"files": [
		"dist/**/*.cjs*",
		"dist/**/*.mjs*",
		"dist/**/*.d*"
	],
	"sideEffects": false,
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"unpkg": "dist/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./effect": {
			"import": {
				"types": "./dist/effect/index.d.mts",
				"default": "./dist/effect/index.mjs"
			},
			"require": {
				"types": "./dist/effect/index.d.cts",
				"default": "./dist/effect/index.cjs"
			}
		}
	},
	"scripts": {
		"bench": "bun bench/index.ts",
		"build": "tsdown",
		"prepack": "bun run build",
		"test": "bun test",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:watch": "bun test --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"effect": "^4.0.0-rc.112"
	},
	"peerDependencies": {
		"effect": "^4.0.0-rc || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		}
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
