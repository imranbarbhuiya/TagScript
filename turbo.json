{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**"],
			"env": ["VERCEL_URL"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "tests/**", "package.json", "vitest.config.mts"],
			"outputs": []
		},
		"test:watch": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"test:coverage": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "tests/**", "package.json", "vitest.config.mts"],
			"outputs": ["coverage/**"]
		}
	},
	"ui": "stream",
	"cacheMaxSize": "2gb",
	"cacheMaxAge": "7d"
}
